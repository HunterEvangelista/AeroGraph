{
  "name": "kioku",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:core": "turbo build --filter=@kioku/core",
    "build:cli": "turbo build --filter=@kioku/cli",
    "build:ai": "turbo build --filter=@kioku/ai",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:core": "turbo lint --filter=@kioku/core",
    "lint:cli": "turbo lint --filter=@kioku/cli",
    "lint:ai": "turbo lint --filter=@kioku/ai",
    "lint:fix": "turbo lint:fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "typecheck:core": "turbo typecheck --filter=@kioku/core",
    "typecheck:cli": "turbo typecheck --filter=@kioku/cli",
    "typecheck:ai": "turbo typecheck --filter=@kioku/ai",
    "typecheck:tsgo": "bun run typecheck:tsgo:core && bun run typecheck:tsgo:cli && bun run typecheck:tsgo:ai",
    "typecheck:tsgo:core": "tsgo --noEmit -p packages/core/tsconfig.json",
    "typecheck:tsgo:cli": "tsgo --noEmit -p packages/cli/tsconfig.json",
    "typecheck:tsgo:ai": "tsgo --noEmit -p packages/ai/tsconfig.json",
    "test": "turbo test",
    "test:core": "turbo test --filter=@kioku/core",
    "test:cli": "turbo test --filter=@kioku/cli",
    "test:ai": "turbo test --filter=@kioku/ai",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@effect/language-service": "^0.77.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=20"
  }
}
