{
  "name": "aerograph",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:core": "turbo build --filter=@aerograph/core",
    "build:cli": "turbo build --filter=@aerograph/cli",
    "build:ai": "turbo build --filter=@aerograph/ai",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:core": "turbo lint --filter=@aerograph/core",
    "lint:cli": "turbo lint --filter=@aerograph/cli",
    "lint:ai": "turbo lint --filter=@aerograph/ai",
    "lint:fix": "turbo lint:fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck && tsc -p tools/oxlint/tsconfig.json && tsc -p tsconfig.configs.json",
    "typecheck:ci": "turbo typecheck --force && tsc -p tools/oxlint/tsconfig.json && tsc -p tsconfig.configs.json",
    "typecheck:core": "turbo typecheck --filter=@aerograph/core",
    "typecheck:cli": "turbo typecheck --filter=@aerograph/cli",
    "typecheck:ai": "turbo typecheck --filter=@aerograph/ai",
    "test": "turbo test",
    "test:core": "turbo test --filter=@aerograph/core",
    "test:cli": "turbo test --filter=@aerograph/cli",
    "test:ai": "turbo test --filter=@aerograph/ai",
    "test:tools": "node --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts",
    "changeset:create": "changeset",
    "changeset:version": "changeset version",
    "changeset:pre-enter": "changeset pre enter alpha",
    "changeset:pre-exit": "changeset pre exit",
    "changeset:publish": "changeset publish",
    "cutover:aero-72": "bun run packages/cli/src/maintenance/aero-72-cutover.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "3.0.1",
    "@effect/tsgo": "^0.24.3",
    "@oxlint/plugins": "1.78.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "1.78.0",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.2.15",
  "engines": {
    "node": ">=22"
  }
}
