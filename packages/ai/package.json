{
  "name": "@aerograph/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "lint:fix": "biome check --write src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aerograph/core": "workspace:*",
    "ai": "^4.0.27",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
