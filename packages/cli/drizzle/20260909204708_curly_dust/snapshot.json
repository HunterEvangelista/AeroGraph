    {
      "value": "(\"operation\" = 'create' AND (\"to_name\" IS NULL OR length(trim(\"to_name\")) > 0) AND \"related_term_id\" IS NULL) OR (\"operation\" = 'rename' AND \"to_name\" IS NOT NULL AND length(trim(\"to_name\")) > 0 AND \"related_term_id\" IS NULL) OR (\"operation\" = 'merge' AND \"to_name\" IS NOT NULL AND length(trim(\"to_name\")) > 0 AND \"related_term_id\" IS NOT NULL) OR (\"operation\" = 'deprecate' AND ((\"to_name\" IS NULL AND \"related_term_id\" IS NULL) OR (\"to_name\" IS NOT NULL AND length(trim(\"to_name\")) > 0 AND \"related_term_id\" IS NOT NULL)))",
