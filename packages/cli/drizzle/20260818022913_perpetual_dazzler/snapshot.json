    {
      "value": "\"migration_journal\".\"kind\" is null OR \"migration_journal\".\"kind\" in ('brand', 'project', 'feature', 'api', 'concept', 'package', 'other')",
      "name": "migration_journal_kind_check",
      "table": "migration_journal",
      "entityType": "checks"
    },
    {
      "value": "(\"migration_journal\".\"operation\" = 'create' AND (\"migration_journal\".\"to_name\" IS NULL OR length(trim(\"migration_journal\".\"to_name\")) > 0) AND \"migration_journal\".\"related_term_id\" IS NULL) OR (\"migration_journal\".\"operation\" = 'rename' AND \"migration_journal\".\"to_name\" IS NOT NULL AND length(trim(\"migration_journal\".\"to_name\")) > 0 AND \"migration_journal\".\"related_term_id\" IS NULL) OR (\"migration_journal\".\"operation\" = 'merge' AND \"migration_journal\".\"to_name\" IS NOT NULL AND length(trim(\"migration_journal\".\"to_name\")) > 0 AND \"migration_journal\".\"related_term_id\" IS NOT NULL) OR (\"migration_journal\".\"operation\" = 'deprecate' AND ((\"migration_journal\".\"to_name\" IS NULL AND \"migration_journal\".\"related_term_id\" IS NULL) OR (\"migration_journal\".\"to_name\" IS NOT NULL AND length(trim(\"migration_journal\".\"to_name\")) > 0 AND \"migration_journal\".\"related_term_id\" IS NOT NULL)))",
      "name": "migration_journal_semantics_check",
      "table": "migration_journal",
      "entityType": "checks"
