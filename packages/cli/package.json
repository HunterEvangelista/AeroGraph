{
  "name": "@aerograph/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "aerograph": "./bin/aerograph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun run ./src/cli.ts",
    "lint": "biome check src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "lint:fix": "biome check --write src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "bun test",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-beta.102",
    "@aerograph/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-beta.102"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.1.14",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
