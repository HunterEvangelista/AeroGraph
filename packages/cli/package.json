{
  "name": "aerograph",
  "description": "Bun-first command-line interface for the AeroGraph local-first knowledge graph, with Node.js support.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HunterEvangelista/AeroGraph.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/HunterEvangelista/AeroGraph/issues"
  },
  "homepage": "https://github.com/HunterEvangelista/AeroGraph#readme",
  "keywords": [
    "aerograph",
    "knowledge-graph",
    "local-first",
    "cli",
    "bun"
  ],
  "version": "0.1.0-alpha.1",
  "type": "module",
  "bin": {
    "aerograph": "./bin/aerograph"
  },
  "files": [
    "package.json",
    "bin/aerograph",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "bun": ">=1.1.38",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "tsc --watch",
    "start": "bun run ./src/cli.ts",
    "lint": "biome check src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "lint:fix": "biome check --write src/; biome_status=$?; oxlint src/; oxlint_status=$?; [ $biome_status -eq 0 ] && [ $oxlint_status -eq 0 ]",
    "typecheck": "tsc -p tsconfig.tests.json && tsc -p scripts/tsconfig.json",
    "test": "bun test",
    "test:watch": "vitest",
    "pack:inspect": "npm pack --dry-run",
    "pack:smoke": "bun run scripts/pack-smoke.ts",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@aerograph/core": "workspace:*",
    "@biomejs/biome": "^2.4.16",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/bun": "^1.1.14",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
