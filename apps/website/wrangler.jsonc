{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aerograph-website",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "aerograph.dev", "custom_domain": true }]
}
